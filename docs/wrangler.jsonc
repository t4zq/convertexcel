{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "convertexcel-docs",
  "compatibility_date": "2026-06-19",
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "docs.convertexcel.net",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 }
  }
}
