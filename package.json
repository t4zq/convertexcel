{
  "name": "convertexcel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "node scripts/cloudflare-build.mjs",
    "build:addin": "npm --prefix frontend run build:addin",
    "build:cloudflare": "node scripts/cloudflare-build.mjs",
    "check:addin": "node scripts/check-addin-local.mjs",
    "check:local": "node scripts/check-local.mjs",
    "deploy": "npm run build && npx wrangler versions upload",
    "deploy:cloudflare": "npm run build && npx wrangler versions upload",
    "dev": "node scripts/dev.mjs",
    "dev:addin": "npm --prefix frontend run dev:addin",
    "dev:engine": "docker compose run --rm engine",
    "dev:full": "node scripts/dev.mjs",
    "dev:api": "wrangler dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "docs:dev": "npm --prefix docs run dev",
    "docs:build": "npm --prefix docs run build",
    "docs:deploy": "npm --prefix docs run deploy",
    "addin:cert:create": "powershell -ExecutionPolicy Bypass -File addin/scripts/create-dev-cert.ps1",
    "addin:cert:trust": "powershell -ExecutionPolicy Bypass -File addin/scripts/trust-dev-cert.ps1",
    "typecheck:worker": "tsc -p worker/tsconfig.json"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250524.0",
    "typescript": "^5.7.2",
    "wrangler": "^4.0.0"
  }
}
