{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "convertexcel",
  "main": "worker/index.ts",
  "compatibility_date": "2026-05-24",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "convertexcel",
      // `wrangler d1 create convertexcel` 実行後に出力される ID を貼る。
      
      "database_id": "e5d7ef9d-d8a3-4105-bec6-37ab1e623693",
      "migrations_dir": "worker/migrations"
    }
  ]
}
